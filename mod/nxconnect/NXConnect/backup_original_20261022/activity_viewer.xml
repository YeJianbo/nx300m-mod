<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:id="@+id/viewerContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <!-- 图像主舞台 (充满整个屏幕，纯黑沉浸) -->
        <FrameLayout
            android:id="@+id/imageStage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000" />
        </FrameLayout>

        <!-- 三星 OneUI 风格上滑详细信息抽屉 (独立悬浮卡片) -->
        <com.nxwa.nxconnect.ui.DetailsScrollView
            android:id="@+id/detailsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_details_sheet"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="always"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="42dp">

                <!-- 抽屉顶部拖拽指示药丸 Handle -->
                <View
                    android:layout_width="38dp"
                    android:layout_height="4.5dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_drag_handle" />

                <!-- 头部：拍摄日期时间 + 编辑源信息入口 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/infoDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2026年10月9日 星期五 · 14:01"
                        android:textColor="@color/nx_on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/infoEdit"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_gallery_touch"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical|end"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="编辑"
                        android:textColor="@color/nx_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 文件名与存储路径 -->
                <TextView
                    android:id="@+id/infoFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/nx_on_surface_variant"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/infoPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/nx_on_surface_variant"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />

                <!-- 格式与同步状态标签行 (RAW / JPEG / 机身SD卡同步) -->
                <LinearLayout
                    android:id="@+id/rowFormatBadges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/badgeFormat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="RAW + JPEG"
                        android:textColor="@color/gallery_badge_blue_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/badgeCameraSync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_capsule_pill"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="相册信息已修改"
                        android:textColor="@color/nx_on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 三星 OneUI 标志性曝光参数五联胶囊行 -->
                <LinearLayout
                    android:id="@+id/exposurePillRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <!-- 光圈 -->
                    <LinearLayout
                        android:id="@+id/capsuleApertureCol"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_capsule_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="光圈"
                            android:textColor="@color/nx_on_surface_variant"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/capsuleAperture"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="F--"
                            android:textColor="@color/nx_on_surface"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Space
                        android:layout_width="5dp"
                        android:layout_height="wrap_content" />

                    <!-- 快门 -->
                    <LinearLayout
                        android:id="@+id/capsuleShutterCol"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_capsule_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="快门"
                            android:textColor="@color/nx_on_surface_variant"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/capsuleShutter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="1/250s"
                            android:textColor="@color/nx_on_surface"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Space
                        android:layout_width="5dp"
                        android:layout_height="wrap_content" />

                    <!-- 焦距 -->
                    <LinearLayout
                        android:id="@+id/capsuleFocalCol"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_capsule_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="等效焦距"
                            android:textColor="@color/nx_on_surface_variant"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/capsuleFocal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="--mm"
                            android:textColor="@color/nx_on_surface"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Space
                        android:layout_width="5dp"
                        android:layout_height="wrap_content" />

                    <!-- 感光度 -->
                    <LinearLayout
                        android:id="@+id/capsuleIsoCol"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_capsule_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="感光度"
                            android:textColor="@color/nx_on_surface_variant"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/capsuleIso"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="ISO 800"
                            android:textColor="@color/nx_on_surface"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Space
                        android:layout_width="5dp"
                        android:layout_height="wrap_content" />

                    <!-- 曝光补偿 -->
                    <LinearLayout
                        android:id="@+id/capsuleEvCol"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_capsule_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="曝光补偿"
                            android:textColor="@color/nx_on_surface_variant"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/capsuleEv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0.0 EV"
                            android:textColor="@color/nx_on_surface"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 拍摄设备卡片 (机身与镜头，OneUI 9 优雅圆角卡片) -->
                <LinearLayout
                    android:id="@+id/cardDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_info_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 机身行 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/nx_primary" />

                        <TextView
                            android:id="@+id/infoCamera"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="SAMSUNG NX300M"
                            android:textColor="@color/nx_on_surface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- 机身画幅与像素胶囊标签 -->
                        <TextView
                            android:id="@+id/infoCameraBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="APS-C 20.3MP"
                            android:textColor="@color/gallery_badge_blue_text"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.6dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/nx_outline_variant" />

                    <!-- 镜头行 (支持直接补录与编辑) -->
                    <LinearLayout
                        android:id="@+id/rowLens"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_gallery_touch"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_lens"
                            app:tint="@color/nx_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/infoLens"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="手动转接老镜头"
                                android:textColor="@color/nx_on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/infoLensSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="未记录光圈与焦距，点击补录"
                                android:textColor="@color/nx_on_surface_variant"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- 快捷补录操作药丸按键 -->
                        <TextView
                            android:id="@+id/infoLensAction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_badge_pill_ripple"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="12dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp"
                            android:text="补录"
                            android:textColor="@color/gallery_badge_blue_text"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 图像规格卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_info_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="图像规格"
                        android:textColor="@color/nx_on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/infoSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/nx_on_surface_variant"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 展开 EXIF 开关与内容 -->
                <TextView
                    android:id="@+id/exifToggle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_gallery_touch"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:text="展开完整 EXIF 属性"
                    android:textColor="@color/nx_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/allExif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_info_card"
                    android:lineSpacingExtra="6dp"
                    android:padding="16dp"
                    android:textColor="@color/nx_on_surface_variant"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/infoStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/nx_on_surface_variant"
                    android:textSize="13sp" />

            </LinearLayout>
        </com.nxwa.nxconnect.ui.DetailsScrollView>
    </FrameLayout>

    <!-- 顶部返回悬浮小胶囊 -->
    <com.nxwa.nxconnect.ui.GalleryGlass
        android:id="@+id/backGlass"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:elevation="2dp"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_gallery_touch"
            android:contentDescription="返回"
            android:padding="12dp"
            android:src="@drawable/ic_gallery_back"
            app:tint="@color/nx_on_surface" />
    </com.nxwa.nxconnect.ui.GalleryGlass>

    <!-- 底部操作悬浮栏 -->
    <LinearLayout
        android:id="@+id/bottomChrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="10dp">

        <!-- 胶片条 (Filmstrip) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/filmstrip"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            android:clipToPadding="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />

        <!-- 悬浮液态玻璃操作药丸 Dock -->
        <com.nxwa.nxconnect.ui.GalleryGlass
            android:id="@+id/actionDock"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:elevation="3dp"
            android:orientation="horizontal"
            android:padding="6dp">

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_gallery_touch"
                android:contentDescription="收藏"
                android:padding="14dp"
                android:src="@drawable/ic_gallery_heart"
                app:tint="@color/nx_on_surface" />

            <ImageButton
                android:id="@+id/btnEdit"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_gallery_touch"
                android:contentDescription="编辑镜头信息"
                android:padding="14dp"
                android:src="@drawable/ic_gallery_edit"
                app:tint="@color/nx_on_surface" />

            <ImageButton
                android:id="@+id/btnInfo"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_gallery_touch"
                android:contentDescription="详细信息"
                android:padding="14dp"
                android:src="@drawable/ic_gallery_info"
                app:tint="@color/nx_on_surface" />

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_gallery_touch"
                android:contentDescription="分享"
                android:padding="14dp"
                android:src="@drawable/ic_gallery_share"
                app:tint="@color/nx_on_surface" />

            <ImageButton
                android:id="@+id/btnDownload"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_gallery_touch"
                android:contentDescription="下载原片"
                android:padding="14dp"
                android:src="@drawable/ic_download"
                app:tint="@color/nx_on_surface" />

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_gallery_touch"
                android:contentDescription="更多"
                android:padding="14dp"
                android:src="@drawable/ic_gallery_more"
                app:tint="@color/nx_on_surface" />
        </com.nxwa.nxconnect.ui.GalleryGlass>
    </LinearLayout>

</FrameLayout>
