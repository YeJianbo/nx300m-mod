<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Views host theme; One UI resources and motion are adapted in this app. -->
    <style name="Theme.NXConnect" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nx_primary</item>
        <item name="colorControlActivated">@color/nx_primary</item>
        <item name="android:colorControlActivated">@color/nx_primary</item>
        <item name="colorOnPrimary">@color/nx_on_primary</item>
        <item name="colorPrimaryContainer">@color/nx_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/nx_on_primary_container</item>
        <item name="colorSecondary">@color/nx_secondary</item>
        <item name="colorOnSecondary">@color/nx_on_secondary</item>
        <item name="colorSecondaryContainer">@color/nx_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/nx_on_secondary_container</item>
        <item name="colorTertiary">@color/nx_tertiary</item>
        <item name="colorOnTertiary">@color/nx_on_tertiary</item>
        <item name="colorError">@color/nx_error</item>
        <item name="colorOnError">@color/nx_on_error</item>
        <item name="colorErrorContainer">@color/nx_error_container</item>
        <item name="colorOnErrorContainer">@color/nx_on_error_container</item>

        <item name="android:colorBackground">@color/nx_background</item>
        <item name="colorOnBackground">@color/nx_on_background</item>
        <item name="colorSurface">@color/nx_surface</item>
        <item name="colorOnSurface">@color/nx_on_surface</item>
        <item name="colorSurfaceVariant">@color/nx_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/nx_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/nx_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/nx_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/nx_surface_container_highest</item>
        <item name="colorOutline">@color/nx_outline</item>
        <item name="colorOutlineVariant">@color/nx_outline_variant</item>

        <!-- 透明系统栏，内容延伸到状态栏/导航栏下方，由各页面的 insets 处理 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/nx_background</item>
        <item name="materialCardViewStyle">@style/NxCard</item>
        <item name="materialButtonStyle">@style/NxButton</item>
        <item name="toolbarStyle">@style/NxToolbar</item>
        <item name="materialAlertDialogTheme">@style/NxDialog</item>
        <item name="alertDialogTheme">@style/NxDialog</item>
        <item name="bottomSheetDialogTheme">@style/NxBottomSheetDialog</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="NxDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/nx_primary</item>
        <item name="colorControlActivated">@color/nx_primary</item>
        <item name="android:colorControlActivated">@color/nx_primary</item>
        <item name="colorSurface">@color/nx_surface</item>
        <item name="colorSurfaceContainerHigh">@color/nx_surface</item>
        <item name="backgroundTint">@color/nx_surface</item>
        <item name="shapeAppearanceOverlay">@style/NxDialogShape</item>
        <item name="android:windowBackground">@drawable/bg_oneui_dialog</item>
        <item name="android:windowAnimationStyle">@style/NxDialogAnimation</item>
        <item name="android:backgroundDimAmount">0.25</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="materialAlertDialogTitleTextStyle">@style/NxDialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/NxDialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/NxDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/NxDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/NxDialogButton</item>
        <item name="textAppearanceListItem">@style/NxDialogListText</item>
        <item name="textAppearanceListItemSmall">@style/NxDialogListText</item>
        <item name="listPreferredItemHeightSmall">56dp</item>
    </style>

    <style name="NxDialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/nx_on_surface</item>
        <item name="android:gravity">start</item>
    </style>

    <style name="NxDialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/nx_on_surface_variant</item>
    </style>

    <style name="NxDialogListText" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/nx_on_surface</item>
    </style>

    <style name="NxDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/nx_primary</item>
    </style>

    <style name="NxInputLayout" parent="Widget.Design.TextInputLayout">
        <item name="boxBackgroundMode">none</item>
        <item name="hintTextColor">@color/nx_on_surface_variant</item>
        <item name="android:textColorHint">@color/nx_on_surface_variant</item>
        <item name="hintTextAppearance">@style/NxInputLabel</item>
    </style>

    <style name="NxInputLabel" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/nx_on_surface_variant</item>
    </style>

    <style name="NxInput" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_oneui_input_underline</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/nx_on_surface</item>
        <item name="android:textColorHint">@color/nx_on_surface_variant</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="NxDialogAction" parent="NxDialogButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="NxBottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/NxBottomSheet</item>
        <item name="android:backgroundDimAmount">0.25</item>
    </style>

    <style name="NxBottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearanceOverlay">@style/NxDialogShape</item>
    </style>

    <style name="NxDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/nx_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/nx_dialog_exit</item>
    </style>

    <style name="NxPopupAnimation">
        <item name="android:windowEnterAnimation">@anim/nx_popup_enter</item>
        <item name="android:windowExitAnimation">@anim/nx_dialog_exit</item>
    </style>

    <style name="NxDialogShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/oneui_panel_corner</item>
    </style>

    <style name="Theme.NXConnect.Viewer" parent="Theme.NXConnect">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="NxCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/nx_surface_container</item>
        <item name="cardCornerRadius">@dimen/oneui_card_corner</item>
        <item name="strokeColor">@color/nx_glass_edge</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">0dp</item>
    </style>

    <style name="NxButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">26dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="NxButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">26dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">17sp</item>
        <item name="strokeColor">@color/nx_outline</item>
    </style>

    <style name="NxButton.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">26dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="NxToolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextColor">@color/nx_on_surface</item>
        <item name="subtitleTextColor">@color/nx_on_surface_variant</item>
    </style>

    <!-- 信息行：左标签右数值 -->
    <style name="NxInfoLabel">
        <item name="android:textColor">@color/nx_on_surface_variant</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
    </style>

    <style name="NxInfoValue">
        <item name="android:textColor">@color/nx_on_surface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NxSectionTitle">
        <item name="android:textColor">@color/nx_on_surface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NxNote">
        <item name="android:textColor">@color/nx_text_note</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <!-- 遥控面板上的小按键：紧凑、圆角，用于密集排布 -->
    <style name="NxKeyButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/nx_outline_variant</item>
    </style>

    <!-- 「按住生效」的键：用主色描边区分，暗示操作方式与单击键不同 -->
    <style name="NxKeyButton.Hold">
        <item name="strokeColor">@color/nx_primary</item>
        <item name="android:textColor">@color/nx_primary</item>
    </style>
</resources>
