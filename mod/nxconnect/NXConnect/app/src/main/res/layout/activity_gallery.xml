<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/gallery_page">
    <androidx.coordinatorlayout.widget.CoordinatorLayout android:id="@+id/galleryContent" android:layout_width="match_parent" android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout android:id="@+id/galleryAppBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/gallery_page" app:elevation="0dp" app:liftOnScroll="false" app:layout_behavior="com.nxwa.nxconnect.ui.OneUiAppBarBehavior">
            <com.google.android.material.appbar.CollapsingToolbarLayout android:id="@+id/galleryCollapsing" android:layout_width="match_parent" android:layout_height="280dp" android:minHeight="56dp" app:layout_scrollFlags="scroll|exitUntilCollapsed|snap" app:titleEnabled="false">
                <LinearLayout android:id="@+id/headingContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="72dp">
                    <TextView android:id="@+id/galleryHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:text="照片" android:textColor="@color/nx_on_surface" android:textSize="30sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
                    <TextView android:id="@+id/gallerySubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipe" android:layout_width="match_parent" android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="88dp" android:scrollbars="vertical" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            <ProgressBar android:id="@+id/loading" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:visibility="gone" />
            <LinearLayout android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical" android:padding="32dp" android:visibility="gone">
                <TextView android:id="@+id/emptyLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:lineSpacingExtra="5dp" android:text="没有照片" android:textColor="@color/nx_on_surface_variant" android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="104dp" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_marginEnd="12dp" android:background="@drawable/bg_oneui_floating_toolbar" app:contentInsetStart="0dp" app:contentInsetEnd="0dp" app:contentInsetEndWithActions="0dp" app:titleTextColor="@color/nx_on_surface" app:titleTextAppearance="@style/TextAppearance.NXConnect.GalleryCompact" />
    <FrameLayout android:id="@+id/crumbRow" android:layout_width="match_parent" android:layout_height="56dp" android:layout_gravity="top" android:background="@color/gallery_page" android:visibility="gone">
        <LinearLayout android:id="@+id/selectAllControl" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="4dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_gallery_touch" android:clickable="true" android:focusable="true" android:contentDescription="选择全部照片">
            <ImageView android:id="@+id/selectAllCheck" android:layout_width="22dp" android:layout_height="22dp" android:padding="4dp" android:background="@drawable/bg_gallery_group_check" android:src="@drawable/ic_check" android:contentDescription="@null" app:tint="@color/nx_surface" />
            <TextView android:id="@+id/selectAllText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="全部" android:textSize="10sp" android:textColor="@color/nx_on_surface" />
        </LinearLayout>
        <TextView android:id="@+id/selectionCompactTitle" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="68dp" android:layout_marginEnd="72dp" android:gravity="center_vertical" android:textColor="@color/nx_on_surface" android:textStyle="bold" android:textSize="20sp" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/cancelSelection" android:layout_width="64dp" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="8dp" android:gravity="center" android:text="取消" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/nx_on_surface" android:background="@drawable/bg_gallery_touch" android:clickable="true" android:focusable="true" />
    </FrameLayout>
    <com.nxwa.nxconnect.ui.GalleryGlass android:id="@+id/navigationDock" android:layout_width="match_parent" android:layout_height="64dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="10dp" android:orientation="horizontal" android:padding="4dp" android:background="@drawable/bg_oneui_gallery_navigation" android:clipToOutline="true" android:elevation="3dp">
        <LinearLayout android:id="@+id/tabPhotos" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_oneui_gallery_tab" android:clickable="true" android:focusable="true" android:contentDescription="照片" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_oneui_gallery_tab_photo" android:duplicateParentState="true" android:contentDescription="@null" app:tint="@color/nx_on_surface" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="照片" android:textColor="@color/nx_on_surface" android:textSize="11sp" android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tabAlbums" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_oneui_gallery_tab" android:clickable="true" android:focusable="true" android:contentDescription="相册" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_oneui_gallery_tab_album" android:duplicateParentState="true" android:contentDescription="@null" app:tint="@color/nx_on_surface" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="相册" android:textColor="@color/nx_on_surface" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tabFavorites" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_oneui_gallery_tab" android:clickable="true" android:focusable="true" android:contentDescription="收藏" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_oneui_gallery_tab_favorite" android:duplicateParentState="true" android:contentDescription="@null" app:tint="@color/nx_on_surface" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="收藏" android:textColor="@color/nx_on_surface" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tabMenu" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_oneui_gallery_tab" android:clickable="true" android:focusable="true" android:contentDescription="菜单" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_gallery_menu" android:duplicateParentState="true" android:contentDescription="@null" app:tint="@color/nx_on_surface" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="菜单" android:textColor="@color/nx_on_surface" android:textSize="11sp" />
        </LinearLayout>
    </com.nxwa.nxconnect.ui.GalleryGlass>
    <com.google.android.material.card.MaterialCardView android:id="@+id/bottomBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:layout_gravity="bottom" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="10dp" android:visibility="gone" app:cardBackgroundColor="@color/gallery_card_bg" app:cardCornerRadius="32dp" app:cardElevation="3dp" app:strokeWidth="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnBatchLens" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="补录镜头" android:textSize="14sp" app:icon="@drawable/ic_lens" app:iconSize="24dp" app:iconGravity="textStart" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDownload" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="下载" android:textSize="14sp" app:icon="@drawable/ic_download" app:iconSize="24dp" app:iconGravity="textStart" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
