<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="2dp"
      android:paddingEnd="2dp"
      android:paddingBottom="20dp">
      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        app:cardBackgroundColor="@color/nx_surface_container"
        app:cardCornerRadius="@dimen/oneui_card_corner"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        android:id="@+id/hubCard">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingStart="20dp"
          android:paddingTop="4dp"
          android:paddingEnd="20dp"
          android:paddingBottom="4dp">
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">
            <com.google.android.material.button.MaterialButton
              android:id="@+id/btnNfc"
              style="@style/Widget.Material3.Button.TextButton"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="碰一碰"
              android:minHeight="48dp"
              android:insetTop="0dp"
              android:insetBottom="0dp"
              android:paddingStart="12dp"
              android:paddingEnd="12dp"
              android:textColor="@color/nx_on_surface"
              android:textSize="16sp"
              android:textStyle="bold"
              app:cornerRadius="20dp"
              app:icon="@drawable/ic_oneui_nfc"
              app:iconSize="24dp"
              app:iconPadding="8dp"
              app:iconTint="@color/nx_on_surface"
              app:iconGravity="textStart" />
            <com.google.android.material.button.MaterialButton
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:id="@+id/btnPair"
              app:icon="@drawable/ic_oneui_connect"
              app:iconSize="24dp"
              app:iconPadding="8dp"
              app:iconTint="@color/nx_on_surface"
              app:iconGravity="textStart"
              style="@style/Widget.Material3.Button.TextButton"
              android:text="连接"
              android:minHeight="48dp"
              android:insetTop="0dp"
              android:insetBottom="0dp"
              android:paddingStart="12dp"
              android:paddingEnd="0dp"
              android:textColor="@color/nx_on_surface"
              android:textSize="16sp"
              android:gravity="center"
              app:cornerRadius="20dp"
              android:textStyle="bold" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/nx_surface_container"
        app:cardCornerRadius="@dimen/oneui_card_corner"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        android:id="@+id/actionRow">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:paddingStart="12dp"
          android:paddingEnd="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="4dp">
          <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="108dp"
            android:id="@+id/btnGallery"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="相册"
            android:minHeight="56dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/nx_on_surface"
            android:textSize="15sp"
            android:gravity="center"
            app:cornerRadius="24dp"
            android:layout_weight="1"
            app:icon="@drawable/ic_photo_library"
            app:iconSize="28dp"
            app:iconTint="#4F86E9"
            app:iconPadding="12dp"
            app:iconGravity="top" />
          <View
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:layout_gravity="center_vertical"
            android:background="@color/nx_outline_variant" />
          <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="108dp"
            android:id="@+id/btnRemote"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="遥控"
            android:minHeight="56dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/nx_on_surface"
            android:textSize="15sp"
            android:gravity="center"
            app:cornerRadius="24dp"
            android:layout_weight="1"
            app:icon="@drawable/ic_remote"
            app:iconSize="28dp"
            app:iconTint="#AE84CF"
            app:iconPadding="12dp"
            app:iconGravity="top" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/nx_surface_container"
        app:cardCornerRadius="@dimen/oneui_card_corner"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        android:id="@+id/cameraSettingsGroup">
        <LinearLayout
          android:id="@+id/btnCameraSettings"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:minHeight="80dp"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:padding="20dp"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?attr/selectableItemBackground">
          <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_oneui_settings"
            android:importantForAccessibility="no"
            app:tint="@color/nx_primary" />
          <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="相机设置"
              android:textColor="@color/nx_on_surface"
              android:textSize="17sp" />
            <TextView
              android:id="@+id/cameraSettingsSummary"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:text="连接相机后可设置"
              android:textColor="@color/nx_on_surface_variant"
              android:textSize="13sp" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/nx_surface_container"
        app:cardCornerRadius="@dimen/oneui_card_corner"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        android:id="@+id/manualGroup">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">
          <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/btnManual"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="手动连接"
            android:minHeight="60dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/nx_on_surface"
            android:textSize="17sp"
            android:gravity="start|center_vertical"
            app:cornerRadius="0dp"
            app:icon="@drawable/ic_wifi"
            app:iconSize="24dp"
            app:iconTint="@color/nx_primary"
            app:iconPadding="14dp"
            app:iconGravity="start" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/nx_surface_container"
        app:cardCornerRadius="@dimen/oneui_card_corner"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">
          <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/btnLensMetadata"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="手动镜头信息"
            android:minHeight="64dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/nx_on_surface"
            android:textSize="17sp"
            android:gravity="start|center_vertical"
            app:cornerRadius="0dp"
            app:icon="@drawable/ic_lens"
            app:iconSize="24dp"
            app:iconTint="@color/nx_primary"
            app:iconPadding="14dp"
            app:iconGravity="start" />
          <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="58dp"
            android:layout_marginEnd="20dp"
            android:background="@color/nx_outline_variant" />
          <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/btnAppearance"
            app:icon="@drawable/ic_oneui_appearance"
            app:iconSize="24dp"
            app:iconPadding="14dp"
            app:iconTint="@color/nx_primary"
            app:iconGravity="start"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="外观 · 跟随系统"
            android:minHeight="64dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/nx_on_surface"
            android:textSize="17sp"
            android:gravity="start|center_vertical"
            app:cornerRadius="0dp" />
          <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/nx_outline_variant" />
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="关于相机"
            android:textColor="@color/nx_on_surface"
            android:textSize="17sp"
            android:fontFamily="sans-serif"
            android:id="@+id/btnAbout"
            app:drawableStartCompat="@drawable/ic_gallery_info"
            android:drawablePadding="14dp"
            app:drawableTint="@color/nx_primary"
            android:minHeight="64dp"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:focusable="true"
            android:clickable="true" />
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mod 与固件"
            android:textColor="@color/nx_on_surface"
            android:textSize="17sp"
            android:fontFamily="sans-serif"
            android:id="@+id/btnModManager"
            app:drawableStartCompat="@drawable/ic_oneui_mod"
            android:drawablePadding="14dp"
            app:drawableTint="@color/nx_primary"
            android:minHeight="64dp"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:focusable="true"
            android:clickable="true" />
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="连接帮助"
            android:textColor="@color/nx_on_surface"
            android:textSize="17sp"
            android:fontFamily="sans-serif"
            android:id="@+id/btnConnectionHelp"
            app:drawableStartCompat="@drawable/ic_oneui_help"
            android:drawablePadding="14dp"
            app:drawableTint="@color/nx_primary"
            android:minHeight="64dp"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:focusable="true"
            android:clickable="true" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
