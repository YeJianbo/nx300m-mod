<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/nx_background">
  <com.google.android.material.appbar.AppBarLayout
    android:id="@+id/homeAppBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/nx_background"
    android:elevation="0dp"
    app:elevation="0dp"
    app:liftOnScroll="false"
    app:layout_behavior="com.nxwa.nxconnect.ui.OneUiAppBarBehavior">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="336dp"
      android:orientation="vertical"
      android:id="@+id/header"
      android:gravity="center"
      android:paddingStart="20dp"
      android:paddingEnd="20dp"
      app:layout_scrollFlags="scroll|snap">
      <ImageView
        android:id="@+id/cameraIllustration"
        android:layout_width="156dp"
        android:layout_height="108dp"
        android:src="@drawable/home_device_cutout"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NX300M"
        android:textColor="@color/nx_on_surface"
        android:textSize="30sp"
        android:fontFamily="sans-serif-medium"
        android:id="@+id/deviceName"
        android:layout_marginTop="14dp" />
      <LinearLayout
        android:id="@+id/connectedStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
          android:id="@+id/statusLine"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="未连接"
          android:textColor="@color/nx_on_surface_variant"
          android:textSize="13sp"
          android:fontFamily="sans-serif-medium"
          android:drawablePadding="5dp" />
        <View
          android:id="@+id/statusBatteryDivider"
          android:layout_width="1dp"
          android:layout_height="12dp"
          android:layout_marginStart="12dp"
          android:layout_marginEnd="12dp"
          android:background="@color/nx_outline_variant"
          android:visibility="gone" />
        <ImageView
          android:id="@+id/headerBattery"
          android:layout_width="26dp"
          android:layout_height="18dp"
          android:contentDescription="相机电量未知"
          android:importantForAccessibility="yes"
          android:visibility="gone" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="12dp">
        <TextView
          android:id="@+id/cameraStateText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="4dp"
          android:gravity="center"
          android:textColor="@color/nx_on_surface_variant"
          android:textSize="14sp"
          android:lineSpacingExtra="3dp"
          android:maxLines="3"
          android:ellipsize="end"
          android:visibility="invisible" />
        <TextView
          android:id="@+id/autoStatus"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:text="连接相机后显示拍摄状态"
          android:textColor="@color/nx_on_surface_variant"
          android:textSize="14sp"
          android:lineSpacingExtra="3dp"
          android:maxLines="2"
          android:ellipsize="end" />
      </LinearLayout>
      <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:indeterminate="true"
        android:visibility="invisible" />
    </LinearLayout>
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:clipChildren="false"
      android:clipToPadding="false">
    <com.google.android.material.appbar.MaterialToolbar
      android:id="@+id/homeToolbar"
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:layout_marginEnd="128dp"
      android:background="@color/nx_background"
      android:elevation="0dp"
      app:titleTextColor="@color/nx_on_surface"
      app:subtitleTextColor="@color/nx_on_surface_variant"
      app:subtitleTextAppearance="@style/TextAppearance.NXConnect.HomeStatus"
      app:contentInsetStartWithNavigation="12dp" />
    <com.google.android.material.appbar.MaterialToolbar
      android:id="@+id/homeActions"
      android:layout_width="104dp"
      android:layout_height="48dp"
      android:layout_gravity="end|center_vertical"
      android:layout_marginEnd="12dp"
      android:background="@android:color/transparent"
      android:elevation="0dp"
      app:contentInsetStart="0dp"
      app:contentInsetEnd="0dp"
      app:contentInsetEndWithActions="0dp" />
    </FrameLayout>
  </com.google.android.material.appbar.AppBarLayout>
  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:overScrollMode="never"
    app:layout_behavior="@string/appbar_scrolling_view_behavior" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
