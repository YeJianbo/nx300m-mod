<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/nx_surface">
    <FrameLayout android:id="@+id/viewerContent" android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="true">
        <FrameLayout android:id="@+id/imageStage" android:layout_width="match_parent" android:layout_height="match_parent">
            <androidx.viewpager2.widget.ViewPager2 android:id="@+id/pager" android:layout_width="match_parent" android:layout_height="match_parent" />
        </FrameLayout>
        <com.nxwa.nxconnect.ui.DetailsScrollView android:id="@+id/detailsScroll" android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_gravity="bottom" android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingStart="24dp" android:paddingTop="18dp" android:paddingEnd="24dp" android:paddingBottom="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="48dp">
                    <TextView android:id="@+id/infoDate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="12dp" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/nx_on_surface" android:textStyle="bold" />
                    <TextView android:id="@+id/infoEdit" android:layout_width="48dp" android:layout_height="48dp" android:gravity="end|center_vertical" android:text="编辑" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/nx_primary" android:background="@drawable/bg_oneui_action_touch" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/infoFile" style="@style/NxPhotoDetailText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true" />
                <TextView android:id="@+id/infoPath" style="@style/NxPhotoDetailText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textIsSelectable="true" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/infoCamera" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="12dp" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/nx_on_surface" android:textStyle="bold" />
                    <TextView android:id="@+id/badgeFormat" style="@style/NxPhotoFormatBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <TextView android:id="@+id/infoLens" style="@style/NxPhotoDetailText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" />
                <TextView android:id="@+id/infoSize" style="@style/NxPhotoDetailText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
                <TextView android:id="@+id/infoExposure" style="@style/NxPhotoDetailText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" />
                <TextView android:id="@+id/badgeCameraSync" style="@style/NxPhotoDetailText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="11sp" android:visibility="gone" />
                <TextView android:id="@+id/infoStatus" style="@style/NxPhotoDetailText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />
                <TextView android:id="@+id/exifToggle" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="12dp" android:paddingEnd="16dp" android:gravity="center_vertical" android:text="展开完整 EXIF 属性" android:textSize="12sp" android:textColor="@color/nx_primary" android:background="@drawable/bg_oneui_action_touch" />
                <TextView android:id="@+id/allExif" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:lineSpacingExtra="3dp" android:textIsSelectable="true" android:textColor="@color/nx_on_surface_variant" android:visibility="gone" />
            </LinearLayout>
        </com.nxwa.nxconnect.ui.DetailsScrollView>
    </FrameLayout>
    <FrameLayout android:id="@+id/backGlass" android:layout_width="match_parent" android:layout_height="56dp" android:layout_gravity="top" android:layout_marginStart="12dp" android:layout_marginEnd="12dp">
        <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="start|center_vertical" android:padding="12dp" android:contentDescription="返回相册" android:src="@drawable/ic_gallery_back" app:tint="@color/nx_on_surface" />
        <LinearLayout android:id="@+id/upperActions" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
            <ImageButton android:id="@+id/btnInfo" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/bg_oneui_action_touch" android:contentDescription="照片信息" android:src="@drawable/ic_gallery_info" app:tint="@color/nx_on_surface" />
            <ImageButton android:id="@+id/btnCameraSettings" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/bg_oneui_action_touch" android:contentDescription="相机设置" android:src="@drawable/ic_oneui_settings" app:tint="@color/nx_on_surface" />
        </LinearLayout>
    </FrameLayout>
    <TextView android:id="@+id/viewerFormatBadge" style="@style/NxPhotoFormatBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_marginTop="80dp" android:layout_marginEnd="24dp" />
    <LinearLayout android:id="@+id/bottomChrome" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/filmstrip" android:layout_width="match_parent" android:layout_height="48dp" android:clipToPadding="false" android:overScrollMode="never" />
        <LinearLayout android:id="@+id/actionDock" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
            <ImageButton android:id="@+id/btnFavorite" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:padding="12dp" android:background="@drawable/bg_oneui_action_touch" android:contentDescription="收藏" android:src="@drawable/ic_gallery_heart" app:tint="@color/nx_on_surface" />
            <ImageButton android:id="@+id/btnEdit" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:padding="12dp" android:background="@drawable/bg_oneui_action_touch" android:contentDescription="编辑照片信息" android:src="@drawable/ic_gallery_edit" app:tint="@color/nx_on_surface" />
            <ImageButton android:id="@+id/btnShare" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:padding="12dp" android:background="@drawable/bg_oneui_action_touch" android:contentDescription="分享" android:src="@drawable/ic_gallery_share" app:tint="@color/nx_on_surface" />
            <ImageButton android:id="@+id/btnDownload" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:padding="12dp" android:background="@drawable/bg_oneui_action_touch" android:contentDescription="下载原文件" android:src="@drawable/ic_download" app:tint="@color/nx_on_surface" />
            <ImageButton android:id="@+id/btnMore" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:padding="12dp" android:background="@drawable/bg_oneui_action_touch" android:contentDescription="更多选项" android:src="@drawable/ic_gallery_more" app:tint="@color/nx_on_surface" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
